<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.guillex7</groupId>
    <artifactId>explodeany-parent</artifactId>
    <version>1.13.0</version>
    <name>ExplodeAny parent project</name>

    <packaging>pom</packaging>

    <developers>
        <developer>
            <name>GuilleX7</name>
            <email>GuillermoX7@gmail.com</email>
            <roles>
                <role>Author</role>
            </roles>
        </developer>
    </developers>

    <modules>
        <module>compatibility/compat-common</module>
        <module>compatibility/compat-manager</module>
        <module>compatibility/compat-v1-8</module>
        <module>compatibility/compat-v1-8-3</module>
        <module>compatibility/compat-v1-9</module>
        <module>compatibility/compat-v1-13</module>
        <module>compatibility/compat-v1-13-paper</module>
        <module>compatibility/compat-v1-14</module>
        <module>compatibility/compat-v1-14-paper</module>
        <module>compatibility/compat-v1-16-1</module>
        <module>compatibility/compat-v1-16-1-paper</module>
        <module>compatibility/compat-v1-19-4-paper</module>
        <module>compatibility/compat-v1-20</module>
        <module>compatibility/compat-v1-21-paper</module>
        <module>explodeany</module>
    </modules>

    <properties>
        <explodeany.version>1.13.0</explodeany.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>8</maven.compiler.release>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>spigot-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>codemc-repo</id>
            <url>https://repo.codemc.org/repository/maven-public/</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>
</project>